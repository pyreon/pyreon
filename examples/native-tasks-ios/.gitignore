# Xcode + xcodegen generated artifacts
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/

# Pyreon-emitted Swift lands inside generated/ but is gitignored —
# `scripts/build.sh` regenerates it on every Xcode build.
generated/

# node_modules
node_modules/

# Asset pipeline output — `scripts/build.sh` rematerializes the shared
# assets/ into the catalog on every build.
ios/Assets.xcassets/
ios/fonts/

# Web-host bridge — `scripts/build.sh` rematerializes `webhost/` on every
# build (the CLI writes it to `<outDir>/webhost`), same as the asset outputs
# above. It was the one materialized output missing from this list, so every
# local build left the tree dirty.
ios/webhost/
