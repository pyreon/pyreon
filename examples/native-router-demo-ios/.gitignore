# Generated output from `pyreon-native build` — not committed; produced
# at build time so the source-of-truth is always `src/*.tsx`.
generated/*
!generated/.gitkeep

# Xcode project files — generated from project.yml via xcodegen, not
# committed. Run `./scripts/xcode-setup.sh` to (re)generate.
*.xcodeproj/
*.xcworkspace/
DerivedData/

# Web-host bridge — `scripts/build.sh` rematerializes `webhost/` on every
# build (the CLI writes it to `<outDir>/webhost`), same as the asset outputs
# above. It was the one materialized output missing from this list, so every
# local build left the tree dirty.
ios/webhost/
