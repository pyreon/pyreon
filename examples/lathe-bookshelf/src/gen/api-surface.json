{
  "version": 2,
  "title": "Bookshelf",
  "operations": {
    "createBook": {
      "id": "createBook",
      "method": "POST",
      "path": "/books",
      "params": {},
      "requiredParams": [],
      "body": "json NewBook",
      "response": "Book",
      "tag": "books",
      "summary": "Add a book."
    },
    "getBook": {
      "id": "getBook",
      "method": "GET",
      "path": "/books/:bookId",
      "params": {
        "bookId": "uuid"
      },
      "requiredParams": [
        "bookId"
      ],
      "response": "Book",
      "tag": "books",
      "summary": "One book by id."
    },
    "listAuthors": {
      "id": "listAuthors",
      "method": "GET",
      "path": "/authors",
      "params": {
        "limit": "integer"
      },
      "requiredParams": [],
      "response": "Author[]",
      "tag": "authors",
      "summary": "Every author."
    },
    "listBooks": {
      "id": "listBooks",
      "method": "GET",
      "path": "/books",
      "params": {},
      "requiredParams": [],
      "response": "Book[]",
      "tag": "books",
      "summary": "Every book in the catalogue."
    }
  },
  "models": {
    "Author": {
      "email": "email (optional)",
      "id": "uuid",
      "name": "string"
    },
    "Book": {
      "id": "uuid",
      "pages": "integer (optional)",
      "status": "enum(\"available\"|\"borrowed\"|\"lost\")",
      "subtitle": "string | null (optional)",
      "tags": "string[] (optional)",
      "title": "string"
    },
    "Entity": {
      "id": "uuid"
    },
    "NewBook": {
      "pages": "integer (optional)",
      "title": "string"
    }
  },
  "aliases": {},
  "usage": {
    "Author": "response",
    "Book": "response",
    "Entity": "unused",
    "NewBook": "request"
  }
}
