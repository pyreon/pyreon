<?xml version="1.0" encoding="utf-8"?>
<!--
  Single-activity Compose host. MainActivity calls setContent { TodayApp() },
  where TodayApp is generated from ../native-showcase/src/TodayApp.tsx.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="Today"
        android:allowBackup="true">
        <!-- configChanges: a rotation, dark-mode switch or keyboard change would
             otherwise recreate the activity and reset every remembered state. -->
        <activity
            android:name="com.pyreon.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
