<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest for the Pyreon TodoMVC Android reference.

  Minimal single-activity Compose app. `MainActivity` calls
  `setContent { TodoApp() }` where `TodoApp` is the compiler-emitted
  Composable from `../kotlin/com/pyreon/generated/TodoApp.kt`.

  Mirrors the iOS host's structural simplicity:
    - iOS:     SwiftUI @main App + WindowGroup { ContentView() }
    - Android: AndroidManifest + MainActivity.setContent { TodoApp() }
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="PyreonTodoMVC"
        android:allowBackup="true">
        <!-- configChanges: rotation, a dark-mode switch, a keyboard or window-size
             change would otherwise DESTROY and recreate the activity, and every
             compiler-emitted `remember { mutableStateOf(...) }` would start over.
             Compose recomposes in place instead (the React Native default set). -->
        <activity
            android:name="com.pyreon.MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
