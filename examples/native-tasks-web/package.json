    "@pyreon/sync": "workspace:*",
    "@pyreon/table": "workspace:*",
    "@pyreon/toast": "workspace:*",
    "@pyreon/ui-core": "workspace:*",
    "@pyreon/url-state": "workspace:*",
    "@pyreon/validation": "workspace:*",
