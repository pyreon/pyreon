    "@pyreon/form": "workspace:*",
    "@pyreon/hooks": "workspace:*",
    "@pyreon/hotkeys": "workspace:*",
    "@pyreon/http": "workspace:*",
    "@pyreon/i18n": "workspace:*",
    "@pyreon/kinetic": "workspace:*",
    "@pyreon/machine": "workspace:*",
    "@pyreon/permissions": "workspace:*",
    "@pyreon/primitives": "workspace:*",
    "@pyreon/query": "workspace:*",
    "@pyreon/reactivity": "workspace:*",
    "@pyreon/router": "workspace:*",
    "@pyreon/runtime-dom": "workspace:*",
    "@pyreon/rx": "workspace:*",
