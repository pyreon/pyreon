<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest for the Pyreon Router Demo Android reference.
  Mirror of `native-counter-android/app/src/main/AndroidManifest.xml`
  (different label / different generated composable).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET + cleartext: the useWebSocket device proof connects to the
         loopback echo server over ws:// (cleartext), which Android 9+ blocks
         by default — without the opt-in the OkHttp handshake fails silently
         and "WS: open" never renders. Demo-app-only. -->
    <!-- useOnline() registers a ConnectivityManager.NetworkCallback via
         rememberPyreonNetworkStatus. Normal (install-time) permission;
         without it the registration is refused and the flag degrades to
         its optimistic default instead of reporting the real state. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="PyreonRouterDemo"
        android:allowBackup="true"
        android:usesCleartextTraffic="true">
        <activity
            android:name="com.pyreon.MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The custom scheme the deep-link device test opens. Without an
                 intent-filter the OS has nothing to route to this activity and
                 `am start -a VIEW -d pyreondemo://…` fails before any Pyreon
                 code runs. singleTop (below) is what makes the WARM path
                 deliver onNewIntent instead of recreating the activity. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pyreondemo" />
            </intent-filter>
        </activity>
    </application>
</manifest>
