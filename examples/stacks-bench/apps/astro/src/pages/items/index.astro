---
// https://docs.astro.build/en/guides/actions/#call-actions-from-an-html-form-action
// https://docs.astro.build/en/guides/on-demand-rendering/
import { actions } from 'astro:actions'
import Layout from '../../layouts/Layout.astro'
import Counter from '../../components/Counter'
import { formatPrice, listItems } from '../../lib/data'

const result = Astro.getActionResult(actions.addItem)
if (result && !result.error) {
  return Astro.redirect(`/items/${result.data.id}`)
}
const items = await listItems()
---
<Layout>
  <h1>Items</h1>
  <Counter client:load />
  <ul id="items">
    {items.map((item) => (
      <li><a href={`/items/${item.id}`}>{item.name}</a> <span class="price">{formatPrice(item.price)}</span></li>
    ))}
  </ul>
  <form method="POST" action={actions.addItem}>
    <input name="name" />
    <button type="submit">Add</button>
  </form>
  {result?.error && <p id="form-error">{result.error.message}</p>}
</Layout>
