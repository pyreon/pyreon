{
  "name": "@pyreon/example-native-tasks",
  "version": "0.50.3",
  "private": true,
  "description": "PRIVATE / EXPERIMENTAL — the multi-feature showcase: one source (src/TasksApp.tsx) built for the web (index.html + vite), iOS (ios/) and Android (android/) from this one directory, the layout create-multiplatform scaffolds. Cross-screen store, auth-gated routing, typed params, forms, charts, flow, the WebView host. Device-gated in native-device.yml; the web build is e2e-tested.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run assets && vite",
    "build": "bun run assets && vite build",
    "preview": "vite preview",
    "assets": "bun ../../packages/native/cli/src/cli.ts assets --target=web --source=assets --out=public",
    "build:ios": "bash scripts/build-ios.sh",
    "build:android": "bash scripts/build-android.sh",
    "check": "bun ../../packages/native/cli/src/cli.ts check --source=src/TasksApp.tsx",
    "lint": "oxlint .",
    "test": "echo '[native-tasks] no unit tests; device tests run in native-device.yml, the web build in test:e2e:native-tasks-web'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@pyreon/a11y": "workspace:*",
    "@pyreon/attrs": "workspace:*",
    "@pyreon/auth": "workspace:*",
    "@pyreon/charts": "workspace:*",
    "@pyreon/code": "workspace:*",
    "@pyreon/coolgrid": "workspace:*",
    "@pyreon/core": "workspace:*",
    "@pyreon/dnd": "workspace:*",
    "@pyreon/elements": "workspace:*",
    "@pyreon/flow": "workspace:*",
    "@pyreon/form": "workspace:*",
    "@pyreon/hooks": "workspace:*",
    "@pyreon/hotkeys": "workspace:*",
    "@pyreon/http": "workspace:*",
    "@pyreon/i18n": "workspace:*",
    "@pyreon/kinetic": "workspace:*",
    "@pyreon/machine": "workspace:*",
    "@pyreon/permissions": "workspace:*",
    "@pyreon/primitives": "workspace:*",
    "@pyreon/query": "workspace:*",
    "@pyreon/reactivity": "workspace:*",
    "@pyreon/rich-text": "workspace:*",
    "@pyreon/rocketstyle": "workspace:*",
    "@pyreon/router": "workspace:*",
    "@pyreon/runtime-dom": "workspace:*",
    "@pyreon/rx": "workspace:*",
    "@pyreon/sized-map": "workspace:*",
    "@pyreon/state-tree": "workspace:*",
    "@pyreon/storage": "workspace:*",
    "@pyreon/store": "workspace:*",
    "@pyreon/styler": "workspace:*",
    "@pyreon/sync": "workspace:*",
    "@pyreon/table": "workspace:*",
    "@pyreon/toast": "workspace:*",
    "@pyreon/ui-core": "workspace:*",
    "@pyreon/unistyle": "workspace:*",
    "@pyreon/url-state": "workspace:*",
    "@pyreon/validation": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pyreon/native-cli": "workspace:*",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vite-plugin": "workspace:*",
    "@types/bun": "^1.4.4",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
