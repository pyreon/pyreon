    "lint": "oxlint ."
  },
  "dependencies": {
    "@pyreon/core": "workspace:*",
    "@pyreon/reactivity": "workspace:*",
    "@pyreon/router": "workspace:*",
    "@pyreon/runtime-dom": "workspace:*",
    "@pyreon/server": "workspace:*",
    "@pyreon/vite-plugin": "workspace:*",
    "@pyreon/zero": "workspace:*",
    "@pyreon/zero-content": "workspace:*"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@pyreon/tsconfig": "workspace:*",
    "@types/bun": "^1.4.3",
    "@types/markdown-it": "^14.2.0",
    "markdown-it": "^15.0.3",
    "shiki": "^4.5.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
