<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The quotes screen fetches over the network — without this,
         socket creation fails with EPERM (the round-5 device finding:
         no prior example app ever fetched, so no manifest had it). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The /webhost page hosts a page that calls navigator.geolocation; the
         WebView asks the user per site, then requests this (#3982). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- fetch-arc device proof: the quotes screen fetches
         http://127.0.0.1:8787/quotes.json (the CI fixture server,
         reverse-forwarded into the emulator via `adb reverse`).
         Android blocks cleartext http by default; the network security
         config scopes the exception to loopback only — remote http
         stays blocked. -->
    <application
        android:label="PyreonTasks"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- <WebView>: where a capture file input's camera output is written. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.pyreon.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/pyreon_webview_files" />
        </provider>
        <!-- configChanges: rotation, a dark-mode switch, a keyboard or window-size
             change would otherwise DESTROY and recreate the activity, and every
             compiler-emitted `remember { mutableStateOf(...) }` would start over.
             Compose recomposes in place instead (the React Native default set). -->
        <activity
            android:name="com.pyreon.MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- @pyreon/auth sign-in (useOidc): PyreonAuthActivity opens the provider in a
             browser tab and reports a cancellation when the user comes back without
             finishing; PyreonAuthRedirectActivity receives the redirect on the app's
             scheme (nativeRedirectUri `dev.pyreon.tasks:/oauth`). Sources are wired,
             not an AAR, so there is no library manifest to merge them from. -->
        <activity
            android:name="com.pyreon.runtime.PyreonAuthActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name="com.pyreon.runtime.PyreonAuthRedirectActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dev.pyreon.tasks" />
            </intent-filter>
        </activity>
    </application>
</manifest>
