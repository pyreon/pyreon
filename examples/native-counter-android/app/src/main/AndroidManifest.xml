<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest for the Pyreon Counter Android reference.

  Minimal single-activity Compose app. `MainActivity` calls
  `setContent { Counter() }` where `Counter` is the compiler-emitted
  Composable from `../kotlin/com/pyreon/generated/Counter.kt`.

  Mirror of `native-todomvc-android/app/src/main/AndroidManifest.xml`
  (different label / activity launches a different generated composable).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- M3.3 useNotifications: Android 13+ (API 33) requires the
         POST_NOTIFICATIONS runtime permission to deliver local notifications
         (PyreonNotifications). NotificationManagerCompat no-ops gracefully if
         it isn't granted, so the app never crashes. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Maps/geolocation row: AndroidLocationSource checks FINE/COARSE at
         register time and reports a denial through the error channel; the
         instrumented geolocation test grants FINE via UiAutomation. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Platform-probe hooks (useAudioRecorder / useBluetooth / useSpeech).
         The engines check these at call time and ask the Activity for any
         that are missing; the app declares them. BLUETOOTH_SCAN is the
         API 31+ scan permission (neverForLocation: discovery only, no
         location derived); the legacy trio covers API 26-30. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Package visibility (API 30+): lets TextToSpeech find an engine. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
    <application
        android:label="PyreonCounter"
        android:allowBackup="true">
        <!-- configChanges: rotation, a dark-mode switch, a keyboard or window-size
             change would otherwise DESTROY and recreate the activity, and every
             compiler-emitted `remember { mutableStateOf(...) }` would start over.
             Compose recomposes in place instead (the React Native default set). -->
        <activity
            android:name="com.pyreon.MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
