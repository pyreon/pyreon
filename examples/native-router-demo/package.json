{
  "name": "@pyreon/example-native-router-demo",
  "version": "0.0.0",
  "private": true,
  "description": "PRIVATE / EXPERIMENTAL \u2014 router, tabs, websocket and audio: one source (src/RouterApp.tsx) built for the web (index.html + vite), iOS (ios/) and Android (android/) from this one directory, the layout create-multiplatform scaffolds. Device-gated in native-device.yml; the web build is e2e-tested.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:ios": "bash scripts/build-ios.sh",
    "build:android": "bash scripts/build-android.sh",
    "xcode": "bash scripts/xcode-setup.sh",
    "check": "bun ../../packages/native/cli/src/cli.ts check --source=src/RouterApp.tsx",
    "lint": "oxlint .",
    "test": "echo '[native-router-demo] no unit tests; device tests run in native-device.yml, the web build in test:e2e:native-router-demo-web'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pyreon/attrs": "workspace:*",
    "@pyreon/coolgrid": "workspace:*",
    "@pyreon/core": "workspace:*",
    "@pyreon/elements": "workspace:*",
    "@pyreon/form": "workspace:*",
    "@pyreon/hooks": "workspace:*",
    "@pyreon/http": "workspace:*",
    "@pyreon/primitives": "workspace:*",
    "@pyreon/reactivity": "workspace:*",
    "@pyreon/router": "workspace:*",
    "@pyreon/runtime-dom": "workspace:*",
    "@pyreon/styler": "workspace:*",
    "@pyreon/validate": "workspace:*"
  },
  "devDependencies": {
    "@pyreon/native-cli": "workspace:*",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vite-plugin": "workspace:*",
    "@types/bun": "^1.4.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
