#!/usr/bin/env sh
#
# Pyreon pre-push hook — checks what this push can break, within a time cap.
#
# The work happens in scripts/pre-push.ts (runner: order, cap, lock) and
# scripts/pre-push-plan.ts (classifier: changed path -> checks, pass cache).
# The path -> checks table is in .agents/rules/workflow.md, "Pre-push hook".
#
#   PYREON_PRE_PUSH_CAP_SEC=300   whole-run wall-clock cap; on the cap the hook
#                                 lists what it did not check and lets the push
#                                 through (CI runs all of it). A FAILED check
#                                 still blocks the push.
#   PYREON_PRE_PUSH_NO_CACHE=1    ignore recorded passes for this push
#   PYREON_SKIP_PRE_PUSH=1        skip the hook for one push
#
# Disable: git config --unset core.hooksPath. Re-enable: bun scripts/install-git-hooks.ts

if [ "$PYREON_SKIP_PRE_PUSH" = "1" ]; then
  echo "[pyreon pre-push] PYREON_SKIP_PRE_PUSH=1 — skipping validation"
  exit 0
fi

# Resolve repo root regardless of where the user invoked git push from.
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT" || exit 1

# The git common dir holds the lock, the pass cache and the learned durations,
# shared by every worktree of this clone. GIT_COMMON_DIR is itself a git
# environment variable (unset below), so the resolved path uses another name.
GIT_COMMON_DIR_ABS=$(git rev-parse --git-common-dir)
case "$GIT_COMMON_DIR_ABS" in
  /*) ;;
  *) GIT_COMMON_DIR_ABS="$REPO_ROOT/$GIT_COMMON_DIR_ABS" ;;
esac

# Git exports GIT_DIR, GIT_WORK_TREE, GIT_INDEX_FILE and friends to hooks, and
# they override `cwd` and `git -C` for every git the gates and tests spawn. A
# test that makes a throwaway repo with `git -C <tmp> init` then re-initialises
# THIS repository and writes its `user.email` into our `.git/config`, which is
# how every commit here became `T <t@t.local>`. The hook has everything it needs
# from git above; from here on git must find repositories by directory.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE GIT_PREFIX GIT_QUARANTINE_PATH \
  GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT

# Heuristic: any vitest process older than 10 minutes belonging to this user
# is likely orphaned from a prior worktree session. Warn (don't kill) — the
# user may have an intentional `vitest --watch` going elsewhere.
STALE_VITEST=$(ps -o pid,etime,command -u "$(id -un)" 2>/dev/null \
  | awk '/vitest run|vitest --watch/ && !/awk/ {
      n = split($2, parts, /[-:]/)
      total = 0
      if (n == 2) total = parts[1]*60 + parts[2]
      else if (n == 3) total = parts[1]*3600 + parts[2]*60 + parts[3]
      else if (n == 4) total = parts[1]*86400 + parts[2]*3600 + parts[3]*60 + parts[4]
      if (total > 600) print $1
    }')
if [ -n "$STALE_VITEST" ]; then
  STALE_COUNT=$(echo "$STALE_VITEST" | wc -l | tr -d ' ')
  echo "[pyreon pre-push] ⚠️  $STALE_COUNT vitest process(es) running for >10 minutes detected:"
  echo "$STALE_VITEST" | sed 's/^/                     pid /'
  echo "                     If unintentional, kill them by pid."
  echo
fi

exec bun scripts/pre-push.ts --cache-dir="$GIT_COMMON_DIR_ABS"
