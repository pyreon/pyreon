#!/usr/bin/env sh
#
# Pyreon pre-push hook.
#
# THE CONTRACT: local = fast and direct-only; CI = the full gate.
#
# GitHub CI is a required merge gate and runs the full affected closure (every
# reverse dependent), the native-compiler suite and the Swift/Kotlin lanes. So
# this hook only catches the cheap, likely failures before they cost a CI
# round trip:
#   1. validate-fast (oxlint, lint:pyreon and the doc/dist/budget/manifest
#      gates; lint:pyreon is one of its gates, so the hook does not run it twice)
#   2. typecheck of the DIRECTLY changed workspaces — on a root-file change
#      (bun.lock, root tsconfig/package.json/vitest setup) across the workspace
#   3. tests of the DIRECTLY changed workspaces only (never the closure, never
#      the whole workspace). Native-toolchain packages (packages/native/*) run
#      only when they themselves changed: vitest suites with --maxWorkers=4,
#      KOTLIN_HOME detected from the kotlinc on PATH.
# Steps 2 and 3 skip any package whose inputs are byte-identical to a recorded
# PASS (scripts/pre-push-plan.ts: own tree + @pyreon deps + lockfile/root
# files), so a re-push, rebase or merge from main re-runs only what changed.
# The plan prints what it skipped and why.
#
# ── Timeout & stale-process safety net ──
#
# Each step has a timeout so it cannot hang forever. On timeout: kill the
# step's own process tree, print actionable guidance, exit 1.
#
# Tunable:
#   PYREON_PRE_PUSH_TIMEOUT_SEC=300   # overrides every step's budget
#   PYREON_PRE_PUSH_NO_CACHE=1        # ignore recorded passes for this push
#
# Opt-out:
#   PYREON_SKIP_PRE_PUSH=1 git push   # one-off bypass for emergencies
#   git push --no-verify              # git's native bypass (also works)
#
# Disable entirely:
#   git config --unset core.hooksPath
#
# Re-enable:
#   bun scripts/install-git-hooks.ts

if [ "$PYREON_SKIP_PRE_PUSH" = "1" ]; then
  echo "[pyreon pre-push] PYREON_SKIP_PRE_PUSH=1 — skipping validation"
  exit 0
fi

# Resolve repo root regardless of where the user invoked git push from.
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT" || exit 1

# One validation wall per repository. Two concurrent pushes previously ran the
# same affected graph twice, raced over package-owned test scratch directories,
# exhausted kotlinc/vitest workers, and then reported unrelated ENOTEMPTY,
# timeout, or SIGKILL failures. `mkdir` is atomic on every supported host.
# GIT_COMMON_DIR is itself a git environment variable (unset below), so the
# resolved path lives under a name git does not read. It also holds the pass
# cache, shared by every worktree of this clone.
GIT_COMMON_DIR_ABS=$(git rev-parse --git-common-dir)
case "$GIT_COMMON_DIR_ABS" in
  /*) ;;
  *) GIT_COMMON_DIR_ABS="$REPO_ROOT/$GIT_COMMON_DIR_ABS" ;;
esac
PRE_PUSH_LOCK="$GIT_COMMON_DIR_ABS/pyreon-pre-push.lock"

# Git exports GIT_DIR, GIT_WORK_TREE, GIT_INDEX_FILE and friends to hooks, and
# they override `cwd` and `git -C` for every git the gates and tests spawn. A
# test that makes a throwaway repo with `git -C <tmp> init` then re-initialises
# THIS repository and writes its `user.email` into our `.git/config`, which is
# how every commit here became `T <t@t.local>`. The hook has everything it needs
# from git above; from here on git must find repositories by directory.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE GIT_PREFIX GIT_QUARANTINE_PATH \
  GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT
if ! mkdir "$PRE_PUSH_LOCK" 2>/dev/null; then
  LOCK_PID=$(sed -n '1p' "$PRE_PUSH_LOCK/pid" 2>/dev/null || true)
  if [ -n "$LOCK_PID" ] && kill -0 "$LOCK_PID" 2>/dev/null; then
    echo "[pyreon pre-push] another validation is already running for this repository (pid $LOCK_PID)."
    echo "[pyreon pre-push] Wait for that push to finish, then retry; concurrent walls are intentionally blocked."
    exit 1
  fi
  # A machine crash cannot run the EXIT trap. Reclaim only this exact stale
  # lock (two narrow operations, no recursive deletion), then retry atomically.
  rm -f "$PRE_PUSH_LOCK/pid"
  rmdir "$PRE_PUSH_LOCK" 2>/dev/null || true
  if ! mkdir "$PRE_PUSH_LOCK" 2>/dev/null; then
    echo "[pyreon pre-push] could not reclaim the stale validation lock at $PRE_PUSH_LOCK"
    exit 1
  fi
fi
echo "$$" > "$PRE_PUSH_LOCK/pid"
TEST_OUTPUT_FILE=""
PLAN_STATE_FILE=""
cleanup() {
  if [ -n "$TEST_OUTPUT_FILE" ]; then rm -f "$TEST_OUTPUT_FILE"; fi
  if [ -n "$PLAN_STATE_FILE" ]; then rm -f "$PLAN_STATE_FILE"; fi
  rm -f "$PRE_PUSH_LOCK/pid"
  rmdir "$PRE_PUSH_LOCK" 2>/dev/null || true
}
trap cleanup EXIT
# A signal must END the hook, not just run cleanup and fall through to the next
# step with the lock already released (sh resumes after a trap handler).
trap 'exit 130' HUP INT TERM

TIMEOUT_SEC="${PYREON_PRE_PUSH_TIMEOUT_SEC:-300}"

# validate-fast gets its OWN budget, and it must not be the 300s default.
# The gate wall is NOT the advertised "~2-5s" on a loaded machine: measured
# 148s at load ~20, 211s at load 333 and 496s at load 443 (2026-08). A killed
# step reads as "your gates are broken", and the rational response to that is
# to bypass the hook — which is how a wall stops being run at all. An explicit
# PYREON_PRE_PUSH_TIMEOUT_SEC still wins outright.
VF_TIMEOUT_SEC="${PYREON_PRE_PUSH_TIMEOUT_SEC:-900}"

echo "[pyreon pre-push] local validation: fast gates + typecheck/tests of DIRECTLY changed packages (CI runs the full closure)"
echo "[pyreon pre-push] per-step timeout: ${TIMEOUT_SEC}s. bypass with PYREON_SKIP_PRE_PUSH=1 or git push --no-verify"
echo

# ── Stale-process check ──────────────────────────────────────────────
# Heuristic: any vitest process older than 10 minutes belonging to this
# user is likely orphaned from a prior worktree session. Warn (don't kill)
# — the user may have an intentional `vitest --watch` going elsewhere.
STALE_VITEST=$(ps -o pid,etime,command -u "$(id -un)" 2>/dev/null \
  | awk '/vitest run|vitest --watch/ && !/awk/ {
      # etime format: [[DD-]HH:]MM:SS
      n = split($2, parts, /[-:]/)
      total = 0
      if (n == 2) total = parts[1]*60 + parts[2]              # MM:SS
      else if (n == 3) total = parts[1]*3600 + parts[2]*60 + parts[3]  # HH:MM:SS
      else if (n == 4) total = parts[1]*86400 + parts[2]*3600 + parts[3]*60 + parts[4]  # DD-HH:MM:SS
      if (total > 600) print $1
    }')
if [ -n "$STALE_VITEST" ]; then
  STALE_COUNT=$(echo "$STALE_VITEST" | wc -l | tr -d ' ')
  echo "[pyreon pre-push] ⚠️  $STALE_COUNT vitest process(es) running for >10 minutes detected:"
  echo "$STALE_VITEST" | sed 's/^/                     pid /'
  echo "                     If unintentional, kill them with: pkill -f 'vitest run'"
  echo
fi

# ── run_with_timeout: portable timeout wrapper ──────────────────────
# Spawn the command in background, poll for completion, kill if exceeded.
# Returns 0 on success, 1 on command failure, 124 on timeout (matching
# coreutils `timeout`'s convention).
# `run_with_timeout_secs` takes the budget EXPLICITLY; `run_with_timeout`
# delegates to it with the shared per-step default, so there is exactly one
# implementation and a per-step budget cannot drift from the generic path.
run_with_timeout_secs() {
  budget_sec="$1"
  step_name="$2"
  shift 2
  cmd="$*"

  # Run in background so we can time it
  eval "$cmd" &
  cmd_pid=$!
  start=$(date +%s)
  while kill -0 "$cmd_pid" 2>/dev/null; do
    now=$(date +%s)
    if [ $((now - start)) -ge "$budget_sec" ]; then
      echo
      echo "[pyreon pre-push] ❌ $step_name exceeded ${budget_sec}s — killing."
      echo "[pyreon pre-push]    This is a CLOCK failure, not a gate failure — the step did not"
      echo "[pyreon pre-push]    report a problem, it ran out of time. Inspect the progress log and"
      echo "[pyreon pre-push]    choose PYREON_PRE_PUSH_TIMEOUT_SEC above ${budget_sec}s before assuming a bug."
      echo "[pyreon pre-push]    This hook has terminated only the timed-out step's process tree."
      echo "[pyreon pre-push]    Inspect any older unrelated watchers before retrying."
      echo "[pyreon pre-push]    Or:  PYREON_SKIP_PRE_PUSH=1 git push  (one-off bypass)"
      terminate_tree "$cmd_pid" TERM
      sleep 2
      terminate_tree "$cmd_pid" KILL
      return 124
    fi
    sleep 1
  done
  wait "$cmd_pid"
  return $?
}

# Kill only descendants of THIS hook step. The old global `pkill -f
# "vitest run"` could terminate an IDE watcher or another worktree and still
# missed kotlinc descendants whose wrapper had already exited.
terminate_tree() {
  tree_pid="$1"
  tree_signal="$2"
  for child_pid in $(pgrep -P "$tree_pid" 2>/dev/null); do
    terminate_tree "$child_pid" "$tree_signal"
  done
  kill -"$tree_signal" "$tree_pid" 2>/dev/null || true
}

run_with_timeout() {
  step_name="$1"
  shift
  run_with_timeout_secs "$TIMEOUT_SEC" "$step_name" "$@"
}

# ── 1. Fast gates (lint + 9 cheap doc/dist/budget/manifest gates) ───
# Replaces the standalone lint step. `validate-fast` runs lint AND every
# gate that has previously tripped freshly-pushed PRs on CI:
#   check-doc-claims, check-changeset-required, check-bundle-budgets,
#   check-distribution, check-release-readiness, check-manifest-depth,
#   check-client-bundle-node-imports, check-shared-source-deps,
#   check-mcp-docs, gen-docs --check.
# Catches the failure modes that the bare lint+typecheck+test triple
# historically missed. Runtime is ~2-5s warm and idle, but scales hard with
# machine load (measured 148s / 211s / 496s at load 20 / 333 / 443) — hence
# VF_TIMEOUT_SEC above rather than the shared per-step default.
echo "[1/3] fast gates (lint, lint:pyreon, doc/dist/budget/manifest)"
run_with_timeout_secs "$VF_TIMEOUT_SEC" "validate-fast" "bun run validate-fast"
VF_RC=$?
if [ $VF_RC -eq 124 ]; then
  exit 1
elif [ $VF_RC -ne 0 ]; then
  echo
  echo "[pyreon pre-push] ❌ fast gates failed — fix the failure(s) above and retry."
  echo "[pyreon pre-push]    Run a single gate to iterate: bun run check-doc-claims,"
  echo "[pyreon pre-push]    bun run gen-docs --check, etc."
  exit 1
fi
echo

# ── 2/3. Plan: direct-only selection minus recorded passes ───────────
# `pre-push-plan.ts` prints shell assignments (validated workspace names,
# single-quoted) on stdout and the human-readable plan on stderr. A planner
# failure FAILS the push rather than silently selecting nothing: an empty
# selection is indistinguishable from "all green" otherwise.
PLAN_STATE_FILE=$(mktemp -t pyreon-pre-push-plan-XXXXXX)
PLAN_NO_CACHE=""
if [ "${PYREON_PRE_PUSH_NO_CACHE:-}" = "1" ]; then PLAN_NO_CACHE="--no-cache"; fi
if ! PLAN_OUT=$(bun scripts/pre-push-plan.ts plan --base=origin/main \
  --cache-dir="$GIT_COMMON_DIR_ABS" --state="$PLAN_STATE_FILE" $PLAN_NO_CACHE); then
  echo "[pyreon pre-push] ❌ could not plan the typecheck/test selection (scripts/pre-push-plan.ts failed above)."
  echo "[pyreon pre-push]    Bypass for this push: PYREON_SKIP_PRE_PUSH=1 git push"
  exit 1
fi
PLAN_ROOT_CHANGED=0 PLAN_TYPECHECK="" PLAN_TEST="" PLAN_NATIVE_VITEST="" PLAN_NATIVE_SCRIPT="" PLAN_KOTLIN_HOME=""
eval "$PLAN_OUT"
echo

record_pass() {
  bun scripts/pre-push-plan.ts record --cache-dir="$GIT_COMMON_DIR_ABS" \
    --state="$PLAN_STATE_FILE" --group="$1" || \
    echo "[pyreon pre-push] (could not record the pass for $1 — it will re-run next push)"
}

# A root-file change typechecks the whole workspace: give it the budget the
# full-workspace typecheck always had. An explicit override always wins.
TYPECHECK_TIMEOUT_SEC="$TIMEOUT_SEC"
if [ "$PLAN_ROOT_CHANGED" = "1" ] && [ -z "${PYREON_PRE_PUSH_TIMEOUT_SEC:-}" ]; then
  TYPECHECK_TIMEOUT_SEC=1800
fi

# ── 2. Typecheck ─────────────────────────────────────────────────────
if [ -n "$PLAN_TYPECHECK" ]; then
  echo "[2/3] typecheck"
  run_with_timeout_secs "$TYPECHECK_TIMEOUT_SEC" "typecheck" "bun run $PLAN_TYPECHECK typecheck"
  TC_RC=$?
  if [ $TC_RC -eq 124 ]; then
    exit 1
  elif [ $TC_RC -ne 0 ]; then
    echo
    echo "[pyreon pre-push] ❌ typecheck failed — fix the errors above and retry."
    exit 1
  fi
  record_pass typecheck
else
  echo "[2/3] typecheck — nothing to run"
fi
echo

# ── 3. Tests ─────────────────────────────────────────────────────────
# run_tests <step-name> <budget> <bun-run-args>
# bun's filter errors when no package in the filtered set has a `test`
# script. The planner already drops those, but keep tolerating the message so
# a renamed script cannot turn a no-op into a red push. bun 1.4.0 says "No
# workspace packages matched the filter", bun 1.4.4 'Script "test" not found
# in N packages' — match both.
run_tests() {
  step_name="$1"
  step_budget="$2"
  step_cmd="$3"
  TEST_OUTPUT_FILE=$(mktemp -t pyreon-pre-push-XXXXXX)
  run_with_timeout_secs "$step_budget" "$step_name" "$step_cmd > '$TEST_OUTPUT_FILE' 2>&1"
  TEST_EXIT=$?
  cat "$TEST_OUTPUT_FILE"
  if [ $TEST_EXIT -eq 124 ]; then
    return 1
  elif [ $TEST_EXIT -ne 0 ]; then
    if grep -qE 'packages matched the filter|Script "test" not found in' "$TEST_OUTPUT_FILE"; then
      echo "[pyreon pre-push] (no test scripts in the selected packages — ok)"
    else
      echo
      echo "[pyreon pre-push] ❌ $step_name failed — fix the failures above and retry."
      return 1
    fi
  fi
  rm -f "$TEST_OUTPUT_FILE"
  TEST_OUTPUT_FILE=""
  return 0
}

if [ -z "$PLAN_TEST$PLAN_NATIVE_VITEST$PLAN_NATIVE_SCRIPT" ]; then
  echo "[3/3] tests — nothing to run"
else
  echo "[3/3] tests (directly changed packages)"
  if [ -n "$PLAN_TEST" ]; then
    run_tests "tests" "$TIMEOUT_SEC" "bun run $PLAN_TEST --sequential test --" || exit 1
    record_pass test
  fi
  # Native-toolchain suites run only when the package itself changed (the
  # planner guarantees that). A cold native-compiler run compiles hundreds of
  # Swift/Kotlin fixtures, so it keeps its long budget, and four workers keep
  # kotlinc from exhausting the machine.
  NATIVE_TIMEOUT_SEC="${PYREON_PRE_PUSH_TIMEOUT_SEC:-7200}"
  if [ -n "$PLAN_KOTLIN_HOME" ]; then
    KOTLIN_HOME="$PLAN_KOTLIN_HOME"
    export KOTLIN_HOME
  fi
  if [ -n "$PLAN_NATIVE_VITEST" ]; then
    run_tests "native tests" "$NATIVE_TIMEOUT_SEC" \
      "bun run $PLAN_NATIVE_VITEST --sequential test -- --maxWorkers=4" || exit 1
    record_pass native-vitest
  fi
  if [ -n "$PLAN_NATIVE_SCRIPT" ]; then
    run_tests "native toolchain tests" "$NATIVE_TIMEOUT_SEC" \
      "bun run $PLAN_NATIVE_SCRIPT --sequential test" || exit 1
    record_pass native-script
  fi
fi
echo
echo "[pyreon pre-push] ✓ local checks passed — pushing. CI runs the full affected closure."
