{
  "$schema": "./packages/tools/lint/schema/pyreonlintrc.schema.json",
  "preset": "recommended",
  "rules": {
    "pyreon/no-and-conditional": "off",
    "pyreon/no-map-in-jsx": "off",
    "pyreon/no-children-access": "off",
    "pyreon/no-props-destructure": [
      "error",
      {
        "exemptPaths": [
          "packages/fundamentals/flow/src/components/",
          "packages/fundamentals/code/src/components/",
          "packages/fundamentals/rich-text/src/components/",
          "packages/fundamentals/flow/src/components/flow-component.tsx",
          "packages/fundamentals/code/src/components/diff-editor.tsx",
          "packages/ui-system/kinetic/src/TransitionGroup.tsx",
          "packages/ui-system/kinetic/src/kinetic/StaggerRenderer.tsx",
          "packages/ui-system/kinetic/src/kinetic/CollapseRenderer.tsx",
          "packages/ui-system/kinetic/src/kinetic/GroupRenderer.tsx"
        ]
      }
    ],
    "pyreon/no-window-in-ssr": [
      "error",
      {
        "exemptPaths": [
          "packages/core/runtime-dom/",
          "packages/core/compiler/",
          "-compat/",
          "packages/tools/devtools/",
          "packages/tools/testing/",
          "packages/internals/perf-harness/",
          "packages/internals/test-utils/",
          "__tests__/",
          ".test."
        ]
      }
    ],
    "pyreon/no-unbatched-updates": [
      "warn",
      {
        "exemptPaths": [
          "__tests__/",
          ".test.",
          "packages/native/compiler/"
        ]
      }
    ],
    "pyreon/no-error-without-prefix": [
      "warn",
      {
        "exemptPaths": [
          "packages/zero/create-zero/",
          "packages/zero/create-multiplatform/",
          "packages/tools/testing/"
        ]
      }
    ],
    "pyreon/no-raw-addeventlistener": [
      "info",
      {
        "exemptPaths": [
          "packages/core/runtime-dom/",
          "packages/fundamentals/hooks/",
          "packages/fundamentals/hotkeys/",
          "packages/fundamentals/storage/",
          "packages/core/router/",
          "packages/tools/devtools/",
          "packages/internals/perf-harness/",
          "packages/ui-system/elements/src/Overlay/",
          "packages/fundamentals/http/",
          "packages/tools/atlas/src/verify/",
          "packages/internals/test-utils/src/happy-dom-hashchange-guard.ts",
          "packages/core/runtime-server/",
          "packages/core/server/",
          "packages/ui-system/kinetic/",
          "packages/ui-system/ui-core/",
          "packages/fundamentals/dnd/",
          "packages/fundamentals/url-state/",
          "packages/fundamentals/code/",
          "packages/fundamentals/query/",
          "packages/zero/zero/",
          "packages/zero/zero-content/"
        ]
      }
    ],
    "pyreon/no-raw-setinterval": [
      "info",
      {
        "exemptPaths": [
          "packages/core/runtime-dom/",
          "packages/fundamentals/hooks/",
          "packages/fundamentals/hotkeys/",
          "packages/core/router/",
          "packages/core/primitives/",
          "packages/fundamentals/form/",
          "packages/fundamentals/query/",
          "packages/fundamentals/storage/",
          "packages/ui-system/elements/",
          "packages/ui-system/kinetic/",
          "packages/zero/zero/",
          "packages/zero/zero-content/"
        ]
      }
    ],
    "pyreon/no-imperative-effect-on-create": [
      "warn",
      {
        "exemptPaths": [
          "packages/fundamentals/hooks/",
          "packages/fundamentals/hotkeys/",
          "packages/fundamentals/rx/",
          "__tests__/",
          ".test."
        ]
      }
    ],
    "pyreon/no-process-dev-gate": [
      "error",
      {
        "exemptPaths": [
          "packages/zero/",
          "packages/core/server/",
          "packages/core/runtime-server/",
          "packages/tools/vite-plugin/",
          "packages/tools/cli/",
          "packages/tools/lint/",
          "packages/tools/mcp/",
          "packages/tools/storybook/",
          "packages/tools/typescript/",
          "scripts/"
        ]
      }
    ],
    "pyreon/dev-guard-warnings": [
      "error",
      {
        "exemptPaths": [
          "packages/zero/",
          "packages/core/server/",
          "packages/core/runtime-server/",
          "packages/tools/vite-plugin/",
          "packages/tools/cli/",
          "packages/tools/lint/",
          "packages/tools/mcp/",
          "packages/tools/storybook/",
          "packages/tools/typescript/",
          "packages/native/cli/",
          "packages/core/runtime-dom/src/hydration-debug.ts",
          "-compat/",
          "scripts/",
          "examples/"
        ]
      }
    ],
    "pyreon/no-bare-signal-in-jsx": [
      "info",
      {
        "exemptPaths": [
          "__tests__/",
          ".test."
        ]
      }
    ],
    "pyreon/no-module-signal-in-server-package": [
      "error",
      {
        "exemptPaths": [
          "packages/zero/zero/src/i18n-routing.ts",
          "packages/zero/zero/src/theme.tsx"
        ]
      }
    ],
    "pyreon/prefer-isserver": [
      "warn",
      {
        "exemptPaths": [
          "packages/core/head/src/dom.ts",
          "packages/fundamentals/toast/src/toaster.tsx",
          "packages/fundamentals/virtual/src/use-window-virtualizer.ts",
          "packages/ui-system/elements/src/Overlay/positioning.ts",
          "packages/ui-system/elements/src/Portal/component.tsx",
          "packages/ui-system/styler/src/sheet.ts",
          "packages/internals/test-utils/src/happy-dom-hashchange-guard.ts"
        ]
      }
    ],
    "pyreon/no-dom-in-setup": [
      "warn",
      {
        "exemptPaths": [
          "packages/tools/devtools/",
          "packages/tools/vue-compat/",
          "packages/ui-system/styler/",
          "packages/zero/zero-content/"
        ]
      }
    ]
  }
}
