{
  "name": "@pyreon/native-runtime-swift",
  "version": "0.54.0",
  "description": "Swift Package Manager runtime that compiler-emitted SwiftUI code links against on iOS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/native/runtime-swift"
  },
  "files": [
    "Package.swift",
    "Sources",
    "Tests",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun ../../../scripts/swift-package.ts build",
    "test": "bun ../../../scripts/swift-package.ts test",
    "lint": "echo '[native-runtime-swift] SwiftLint not yet integrated; skipping lint'",
    "typecheck": "bun ../../../scripts/swift-package.ts typecheck"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "pyreon": {
    "stability": "experimental",
    "native": {
      "swift": {
        "module": "PyreonRuntime",
        "dir": "Sources/PyreonRuntime"
      }
    }
  }
}
