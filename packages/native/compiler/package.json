{
  "name": "@pyreon/native-compiler",
  "version": "0.52.0",
  "description": "Pyreon Multi-Target Compiler (PMTC): compiles Pyreon JSX to native Swift (SwiftUI) and Kotlin (Jetpack Compose).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/native/compiler"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./audit": {
      "bun": "./src/audit.ts",
      "import": "./lib/audit.js",
      "types": "./lib/types/audit.d.ts"
    },
    "./testing": {
      "bun": "./src/testing.ts",
      "import": "./lib/testing.js",
      "types": "./lib/types/testing.d.ts"
    }
  },
  "scripts": {
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "coverage": "bun scripts/coverage-gate.ts",
    "coverage:gate": "bun scripts/coverage-gate.ts --gate",
    "coverage:swiftc": "bun scripts/coverage-gate.ts --swiftc-validate",
    "build": "vl_rolldown_build"
  },
  "dependencies": {
    "@pyreon/charts": "workspace:^",
    "@pyreon/compiler": "workspace:*",
    "oxc-parser": "^0.152.0"
  },
  "devDependencies": {
    "@pyreon/http": "workspace:^",
    "@pyreon/query": "workspace:*",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/validate": "workspace:*",
    "@pyreon/vitest-config": "workspace:*",
    "vitest": "^5.0.2"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "!lib/analysis",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
