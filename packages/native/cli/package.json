{
  "name": "@pyreon/native-cli",
  "version": "0.52.0",
  "description": "CLI for the Pyreon Multi-Target Compiler: builds a directory of Pyreon sources to SwiftUI and Jetpack Compose with @pyreon/native-compiler.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/native/cli"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "bin",
    "lib",
    "!lib/analysis",
    "src",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "pyreon-native": "./bin/pyreon-native.js"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    }
  },
  "scripts": {
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vl_rolldown_build"
  },
  "dependencies": {
    "@pyreon/native-compiler": "workspace:*"
  },
  "devDependencies": {
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vitest-config": "workspace:*",
    "vitest": "^4.1.11"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "publishConfig": {
    "access": "public"
  }
}
