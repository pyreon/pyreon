{
  "name": "@pyreon/native-cli",
  "version": "0.51.0",
  "description": "PRIVATE / EXPERIMENTAL \u2014 CLI orchestration for the Pyreon Multi-Target Compiler. Wraps @pyreon/native-compiler in a directory-walking build command. See .claude/plans/native-platforms-phase0-roadmap.md PR 2.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/native/cli"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "bin",
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "pyreon-native": "./bin/pyreon-native.js"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    }
  },
  "scripts": {
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vl_rolldown_build"
  },
  "dependencies": {
    "@pyreon/native-compiler": "workspace:*"
  },
  "devDependencies": {
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vitest-config": "workspace:*",
    "vitest": "^4.1.11"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "publishConfig": {
    "access": "public"
  }
}
