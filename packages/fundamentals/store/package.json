{
  "name": "@pyreon/store",
  "version": "0.51.0",
  "description": "Global state management for Pyreon \u2014 Pinia-inspired composition stores",
  "license": "MIT",
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/fundamentals/store#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/fundamentals/store"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./devtools": {
      "bun": "./src/devtools.ts",
      "import": "./lib/devtools.js",
      "types": "./lib/types/devtools.d.ts",
      "default": "./lib/devtools.js"
    }
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE",
    "native/swift",
    "native/kotlin"
  ],
  "scripts": {
    "build": "vl_rolldown_build",
    "dev": "vl_rolldown_build-watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "bench:stores": "NODE_ENV=production bun bench/store-bench.ts"
  },
  "peerDependencies": {
    "@pyreon/reactivity": "workspace:^"
  },
  "dependencies": {
    "@pyreon/validation": "workspace:^"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.6",
    "@pyreon/manifest": "workspace:*",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vitest-config": "workspace:*",
    "@vitus-labs/tools-lint": "^2.6.3",
    "arktype": "^2.2.3",
    "bun-types": "^1.3.14",
    "jotai": "^2.20.3",
    "valibot": "^1.4.2",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "publishConfig": {
    "access": "public"
  },
  "pyreon": {
    "native": {
      "swift": "native/swift",
      "kotlin": "native/kotlin"
    }
  }
}
