{
  "name": "@pyreon/query",
  "version": "0.52.0",
  "description": "Pyreon adapter for TanStack Query",
  "license": "MIT",
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/fundamentals/query#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/fundamentals/query"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./devtools": {
      "bun": "./src/devtools.tsx",
      "import": "./lib/devtools.js",
      "types": "./lib/types/devtools.d.ts"
    },
    "./persist": {
      "bun": "./src/persist.ts",
      "import": "./lib/persist.js",
      "types": "./lib/types/persist.d.ts"
    }
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE",
    "native/swift",
    "native/kotlin"
  ],
  "scripts": {
    "build": "vl_rolldown_build",
    "dev": "vl_rolldown_build-watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "bench:react-query": "NODE_ENV=production bun bench/query-bench.ts"
  },
  "peerDependencies": {
    "@pyreon/core": "workspace:^",
    "@pyreon/reactivity": "workspace:^"
  },
  "dependencies": {
    "@tanstack/query-async-storage-persister": "^5.102.8",
    "@tanstack/query-core": "^5.102.8",
    "@tanstack/query-devtools": "^5.102.8",
    "@tanstack/query-persist-client-core": "^5.102.8",
    "@tanstack/query-sync-storage-persister": "^5.102.8"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.6",
    "@pyreon/manifest": "workspace:*",
    "@pyreon/runtime-dom": "workspace:^",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vitest-config": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "pyreon": {
    "native": {
      "swift": "native/swift",
      "kotlin": "native/kotlin"
    }
  }
}
