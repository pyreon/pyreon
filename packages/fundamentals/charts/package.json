{
  "name": "@pyreon/charts",
  "version": "0.51.0",
  "description": "Charts for Pyreon on the web, iOS and Android: <Chart> with mark children over a first-party engine (21 chart families, one flat draw list), canvas and SVG, tree-shakeable marks",
  "license": "MIT",
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/fundamentals/charts#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/fundamentals/charts"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./engine": {
      "bun": "./src/engine.ts",
      "import": "./lib/engine.js",
      "types": "./lib/types/engine.d.ts"
    },
    "./svg": {
      "bun": "./src/svg.ts",
      "import": "./lib/svg.js",
      "types": "./lib/types/svg.d.ts"
    }
  },
  "files": [
    "lib",
    "!lib/analysis",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vl_rolldown_build",
    "dev": "vl_rolldown_build-watch",
    "test": "vitest run",
    "test:browser": "vitest run --config ./vitest.browser.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "bench:engine": "NODE_ENV=production bun bench/plot-engine.bench.ts"
  },
  "peerDependencies": {
    "@pyreon/core": "workspace:^",
    "@pyreon/reactivity": "workspace:^"
  },
  "devDependencies": {
    "@pyreon/manifest": "workspace:*",
    "@pyreon/runtime-dom": "workspace:^",
    "@pyreon/runtime-server": "workspace:^",
    "@pyreon/test-utils": "workspace:^",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vitest-config": "workspace:*",
    "@vitest/browser-playwright": "^4.1.11",
    "echarts": "^6.1.0",
    "happy-dom": "^20.11.6",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@pyreon/primitives": "workspace:^"
  }
}
