{
  "name": "@pyreon/charts",
  "version": "0.52.0",
  "description": "Charts for Pyreon on the web, iOS and Android: <Chart> with mark children over a first-party engine (21 chart families, one flat draw list), plus a lazy-loaded ECharts wrapper at /echarts",
  "license": "MIT",
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/fundamentals/charts#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/fundamentals/charts"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./engine": {
      "bun": "./src/engine.ts",
      "import": "./lib/engine.js",
      "types": "./lib/types/engine.d.ts"
    },
    "./svg": {
      "bun": "./src/svg.ts",
      "import": "./lib/svg.js",
      "types": "./lib/types/svg.d.ts"
    },
    "./option": {
      "bun": "./src/option.ts",
      "import": "./lib/option.js",
      "types": "./lib/types/option.d.ts"
    },
    "./echarts": {
      "bun": "./src/echarts.ts",
      "import": "./lib/echarts.js",
      "types": "./lib/types/echarts.d.ts"
    },
    "./echarts/manual": {
      "bun": "./src/echarts/manual.ts",
      "import": "./lib/echarts/manual.js",
      "types": "./lib/types/echarts/manual.d.ts"
    },
    "./echarts/vite": {
      "bun": "./src/echarts/vite.ts",
      "import": "./lib/echarts/vite.js",
      "types": "./lib/types/echarts/vite.d.ts"
    },
    "./webview": {
      "bun": "./src/webview.ts",
      "import": "./lib/webview.js",
      "types": "./lib/types/webview.d.ts"
    },
    "./option-layer": {
      "bun": "./src/option-layer.ts",
      "import": "./lib/option-layer.js",
      "types": "./lib/types/option-layer.d.ts"
    }
  },
  "files": [
    "lib",
    "!lib/analysis",
    "src",
    "README.md",
    "LICENSE",
    "native/swift",
    "native/kotlin"
  ],
  "scripts": {
    "build": "vl_rolldown_build",
    "dev": "vl_rolldown_build-watch",
    "test": "vitest run",
    "test:browser": "vitest run --config ./vitest.browser.config.ts",
    "bench": "NODE_ENV=production bun bench/wrapper-overhead.bench.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "bench:engine": "NODE_ENV=production bun bench/plot-engine.bench.ts",
    "gen:contract": "bun scripts/gen-echarts-contract.ts"
  },
  "peerDependencies": {
    "@pyreon/core": "workspace:^",
    "@pyreon/reactivity": "workspace:^",
    "echarts": ">=5.6.0"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pyreon/manifest": "workspace:*",
    "@pyreon/runtime-dom": "workspace:^",
    "@pyreon/runtime-server": "workspace:^",
    "@pyreon/test-utils": "workspace:^",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vitest-config": "workspace:*",
    "@vitest/browser-playwright": "^4.1.11",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "happy-dom": "^20.11.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@pyreon/primitives": "workspace:^"
  },
  "pyreon": {
    "native": {
      "swift": "native/swift",
      "kotlin": "native/kotlin",
      "kotlinServices": {},
      "kotlinSdkOnly": [
        "PyreonChartWebView.kt"
      ]
    }
  }
}
