{
  "name": "@pyreon/feature",
  "version": "0.53.0",
  "description": "Schema-driven feature primitives — define once, get CRUD hooks, forms, tables, and stores",
  "license": "MIT",
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/fundamentals/feature#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/fundamentals/feature"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./native-plugin": {
      "bun": "./src/native-plugin.ts",
      "import": "./lib/native-plugin.js",
      "types": "./lib/types/native-plugin.d.ts"
    }
  },
  "files": [
    "lib",
    "!lib/analysis",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vl_rolldown_build",
    "dev": "vl_rolldown_build-watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint ."
  },
  "peerDependencies": {
    "@pyreon/core": "workspace:^",
    "@pyreon/reactivity": "workspace:^",
    "@pyreon/native-compiler": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@pyreon/native-compiler": {
      "optional": true
    }
  },
  "dependencies": {
    "@pyreon/form": "workspace:^",
    "@pyreon/http": "workspace:^",
    "@pyreon/query": "workspace:^",
    "@pyreon/store": "workspace:^",
    "@pyreon/table": "workspace:^",
    "@pyreon/validation": "workspace:^",
    "@tanstack/table-core": "^9.1.2"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@pyreon/manifest": "workspace:*",
    "@pyreon/native-compiler": "workspace:*",
    "@pyreon/runtime-dom": "workspace:^",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vitest-config": "workspace:*",
    "arktype": "^2.2.5",
    "valibot": "^1.5.0",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "pyreon": {
    "native": {
      "plugin": "./lib/native-plugin.js",
      "modules": [
        "@pyreon/feature"
      ]
    }
  }
}
