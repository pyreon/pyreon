{
  "name": "@pyreon/dnd",
  "version": "0.53.0",
  "description": "Signal-driven drag and drop for Pyreon — wraps @atlaskit/pragmatic-drag-and-drop",
  "license": "MIT",
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/fundamentals/dnd#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/fundamentals/dnd"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./native-plugin": {
      "bun": "./src/native-plugin.ts",
      "import": "./lib/native-plugin.js",
      "types": "./lib/types/native-plugin.d.ts"
    }
  },
  "files": [
    "lib",
    "!lib/analysis",
    "src",
    "README.md",
    "LICENSE",
    "native/swift",
    "native/kotlin"
  ],
  "scripts": {
    "build": "vl_rolldown_build",
    "dev": "vl_rolldown_build-watch",
    "bench": "NODE_ENV=production bun bench/dnd-wrapper-tax.ts",
    "test": "vitest run",
    "test:browser": "vitest run --config ./vitest.browser.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint ."
  },
  "peerDependencies": {
    "@pyreon/core": "workspace:^",
    "@pyreon/reactivity": "workspace:^",
    "@pyreon/native-compiler": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@pyreon/native-compiler": {
      "optional": true
    }
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.2.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
    "@pyreon/a11y": "workspace:^"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@pyreon/manifest": "workspace:*",
    "@pyreon/native-compiler": "workspace:*",
    "@pyreon/test-utils": "workspace:^",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/typescript": "workspace:^",
    "@pyreon/vitest-config": "workspace:*",
    "@vitest/browser-playwright": "^5.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "pyreon": {
    "native": {
      "swift": "native/swift",
      "kotlin": "native/kotlin",
      "kotlinServices": {
        "PyreonSortable": [
          "PyreonSortable.kt"
        ]
      },
      "kotlinSdkOnly": [
        "PyreonSortableModifier.kt"
      ],
      "plugin": "./lib/native-plugin.js",
      "modules": [
        "@pyreon/dnd"
      ]
    }
  }
}
