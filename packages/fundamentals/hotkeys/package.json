{
  "name": "@pyreon/hotkeys",
  "version": "0.54.0",
  "description": "Reactive keyboard shortcut management for Pyreon — scope-aware, conflict detection",
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/fundamentals/hotkeys#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/fundamentals/hotkeys"
  },
  "files": [
    "lib",
    "!lib/analysis",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./native-plugin": {
      "bun": "./src/native-plugin.ts",
      "import": "./lib/native-plugin.js",
      "types": "./lib/types/native-plugin.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vl_rolldown_build",
    "dev": "vl_rolldown_build-watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "bench:keys": "NODE_ENV=production bun bench/hotkeys-bench.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.3",
    "@pyreon/manifest": "workspace:*",
    "@pyreon/native-compiler": "workspace:*",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vitest-config": "workspace:*",
    "hotkeys-js": "^4.0.8",
    "mousetrap": "^1.6.5",
    "tinykeys": "^4.0.1"
  },
  "peerDependencies": {
    "@pyreon/core": "workspace:^",
    "@pyreon/native-compiler": "workspace:^",
    "@pyreon/reactivity": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@pyreon/native-compiler": {
      "optional": true
    }
  },
  "pyreon": {
    "native": {
      "plugin": "./lib/native-plugin.js",
      "modules": [
        "@pyreon/hotkeys"
      ]
    }
  }
}
