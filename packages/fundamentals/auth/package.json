{
  "name": "@pyreon/auth",
  "version": "0.54.0",
  "description": "Authentication for Pyreon on web, iOS and Android \u2014 OIDC sign-in (useOidc), ID-token verification, signed sessions, TOTP, passkeys and route guards, secure by default",
  "license": "MIT",
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/fundamentals/auth#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/fundamentals/auth"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./passport": {
      "bun": "./src/passport.ts",
      "import": "./lib/passport.js",
      "types": "./lib/types/passport.d.ts"
    },
    "./native-plugin": {
      "bun": "./src/native-plugin.ts",
      "import": "./lib/native-plugin.js",
      "types": "./lib/types/native-plugin.d.ts"
    }
  },
  "files": [
    "lib",
    "!lib/analysis",
    "src",
    "README.md",
    "LICENSE",
    "native/swift",
    "native/kotlin",
    "native/tests"
  ],
  "scripts": {
    "build": "vl_rolldown_build",
    "dev": "vl_rolldown_build-watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint ."
  },
  "peerDependencies": {
    "@pyreon/reactivity": "workspace:^",
    "@pyreon/native-compiler": "workspace:^"
  },
  "devDependencies": {
    "@pyreon/manifest": "workspace:*",
    "@pyreon/native-compiler": "workspace:*",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vitest-config": "workspace:*",
    "@types/oidc-provider": "9.12.1",
    "bun-types": "^1.4.4",
    "oidc-provider": "9.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pyreon": {
    "native": {
      "swift": "native/swift",
      "kotlin": "native/kotlin",
      "swiftCompileWith": [
        "@pyreon/storage/PyreonSecureStorage.swift"
      ],
      "kotlinServices": {
        "PyreonOidc": [
          "PyreonOidc.kt",
          "PyreonAuthJson.kt",
          "PyreonOidcJose.kt",
          "PyreonOidcClient.kt",
          "PyreonOidcAuth.kt",
          "@pyreon/storage/PyreonSecureStorage.kt"
        ]
      },
      "kotlinSdkOnly": [
        "PyreonOidcAndroid.kt"
      ],
      "plugin": "./lib/native-plugin.js",
      "modules": [
        "@pyreon/auth"
      ]
    }
  },
  "dependencies": {
    "@pyreon/storage": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@pyreon/native-compiler": {
      "optional": true
    }
  }
}
