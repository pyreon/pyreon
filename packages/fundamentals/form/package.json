{
  "name": "@pyreon/form",
  "version": "0.53.0",
  "description": "Signal-based form management for Pyreon",
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/fundamentals/form#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/fundamentals/form"
  },
  "files": [
    "lib",
    "!lib/analysis",
    "src",
    "README.md",
    "LICENSE",
    "native/swift",
    "native/kotlin"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./devtools": {
      "bun": "./src/devtools.ts",
      "import": "./lib/devtools.js",
      "types": "./lib/types/devtools.d.ts"
    },
    "./native-plugin": {
      "bun": "./src/native-plugin.ts",
      "import": "./lib/native-plugin.js",
      "types": "./lib/types/native-plugin.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vl_rolldown_build",
    "dev": "vl_rolldown_build-watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "bench": "NODE_ENV=production bun bench/form-bench.ts",
    "bench:rerender": "NODE_ENV=production bun bench/form-rerender-bench.ts"
  },
  "dependencies": {
    "@pyreon/validation": "workspace:^"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@pyreon/manifest": "workspace:*",
    "@pyreon/native-compiler": "workspace:*",
    "@pyreon/runtime-dom": "workspace:^",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/validate": "workspace:*",
    "@pyreon/vitest-config": "workspace:*",
    "@tanstack/form-core": "^1.33.5",
    "arktype": "^2.2.8",
    "formik": "^2.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0"
  },
  "peerDependencies": {
    "@pyreon/core": "workspace:^",
    "@pyreon/native-compiler": "workspace:^",
    "@pyreon/reactivity": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@pyreon/native-compiler": {
      "optional": true
    }
  },
  "pyreon": {
    "native": {
      "swift": "native/swift",
      "kotlin": "native/kotlin",
      "plugin": "./lib/native-plugin.js",
      "modules": [
        "@pyreon/form"
      ]
    }
  }
}
