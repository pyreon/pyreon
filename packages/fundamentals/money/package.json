{
  "name": "@pyreon/money",
  "version": "0.53.0",
  "description": "Exact amounts of money as plain data for Pyreon: decimal-string amounts, bigint math, rounding modes, allocation that never loses a cent",
  "license": "MIT",
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/fundamentals/money#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/fundamentals/money"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./decimal": {
      "bun": "./src/decimal.ts",
      "import": "./lib/decimal.js",
      "types": "./lib/types/decimal.d.ts"
    },
    "./fp": {
      "bun": "./src/fp.ts",
      "import": "./lib/fp.js",
      "types": "./lib/types/fp.d.ts"
    }
  },
  "files": [
    "lib",
    "!lib/analysis",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vl_rolldown_build",
    "dev": "vl_rolldown_build-watch",
    "test": "vitest run --maxWorkers=2",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "bench": "NODE_ENV=production bun bench/money-bench.ts"
  },
  "devDependencies": {
    "@pyreon/manifest": "workspace:*",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vitest-config": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
