{
  "name": "@pyreon/upload",
  "version": "0.54.0",
  "description": "File selection, validation, preview and upload with progress as signals for Pyreon: a queue with retry and pause, XHR progress, drop and picker state",
  "license": "MIT",
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/fundamentals/upload#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/fundamentals/upload"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./core": {
      "bun": "./src/core.ts",
      "import": "./lib/core.js",
      "types": "./lib/types/core.d.ts"
    },
    "./transport-xhr": {
      "bun": "./src/transport-xhr.ts",
      "import": "./lib/transport-xhr.js",
      "types": "./lib/types/transport-xhr.d.ts"
    },
    "./transport-chunked": {
      "bun": "./src/transport-chunked.ts",
      "import": "./lib/transport-chunked.js",
      "types": "./lib/types/transport-chunked.d.ts"
    },
    "./transport-s3": {
      "bun": "./src/transport-s3.ts",
      "import": "./lib/transport-s3.js",
      "types": "./lib/types/transport-s3.d.ts"
    },
    "./transport-tus": {
      "bun": "./src/transport-tus.ts",
      "import": "./lib/transport-tus.js",
      "types": "./lib/types/transport-tus.d.ts"
    },
    "./components": {
      "bun": "./src/components.tsx",
      "import": "./lib/components.js",
      "types": "./lib/types/components.d.ts"
    },
    "./form": {
      "bun": "./src/form.ts",
      "import": "./lib/form.js",
      "types": "./lib/types/form.d.ts"
    },
    "./query": {
      "bun": "./src/query.ts",
      "import": "./lib/query.js",
      "types": "./lib/types/query.d.ts"
    }
  },
  "files": [
    "lib",
    "!lib/analysis",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vl_rolldown_build",
    "dev": "vl_rolldown_build-watch",
    "test": "vitest run --maxWorkers=2",
    "test:browser": "vitest run --config ./vitest.browser.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint ."
  },
  "peerDependencies": {
    "@pyreon/reactivity": "workspace:^",
    "@pyreon/core": "workspace:^"
  },
  "devDependencies": {
    "@pyreon/core": "workspace:*",
    "@pyreon/form": "workspace:*",
    "@pyreon/http": "workspace:*",
    "@pyreon/manifest": "workspace:*",
    "@pyreon/query": "workspace:*",
    "@pyreon/reactivity": "workspace:*",
    "@pyreon/runtime-dom": "workspace:*",
    "@pyreon/runtime-server": "workspace:*",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vitest-config": "workspace:*",
    "@vitest/browser-playwright": "^5.1.0",
    "axe-core": "^4.14.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@pyreon/core": {
      "optional": true
    }
  },
  "pyreon": {
    "stability": "experimental"
  }
}
