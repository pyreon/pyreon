{
  "name": "@pyreon/url-state",
  "version": "0.53.0",
  "description": "Reactive URL search-param state for Pyreon \u2014 signal-backed, type-coerced, SSR-safe",
  "license": "MIT",
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/fundamentals/url-state#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/fundamentals/url-state"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./native-plugin": {
      "bun": "./src/native-plugin.ts",
      "import": "./lib/native-plugin.js",
      "types": "./lib/types/native-plugin.d.ts"
    }
  },
  "files": [
    "lib",
    "!lib/analysis",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vl_rolldown_build",
    "dev": "vl_rolldown_build-watch",
    "test": "vitest run",
    "bench:nuqs": "NODE_ENV=production bun bench/url-state-bench.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint ."
  },
  "peerDependencies": {
    "@pyreon/reactivity": "workspace:^",
    "@pyreon/native-compiler": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@pyreon/native-compiler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@pyreon/core": "workspace:*",
    "@pyreon/manifest": "workspace:*",
    "@pyreon/native-compiler": "workspace:*",
    "@pyreon/router": "workspace:*",
    "@pyreon/runtime-dom": "workspace:*",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vitest-config": "workspace:*",
    "nuqs": "^2.10.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "pyreon": {
    "native": {
      "plugin": "./lib/native-plugin.js",
      "modules": [
        "@pyreon/url-state"
      ]
    }
  }
}
