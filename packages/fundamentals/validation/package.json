{
  "name": "@pyreon/validation",
  "version": "0.53.0",
  "description": "Schema validation adapters for Pyreon forms (Zod, Valibot, ArkType)",
  "license": "MIT",
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/fundamentals/validation#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/fundamentals/validation"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./zod": {
      "bun": "./src/zod.ts",
      "import": "./lib/zod.js",
      "types": "./lib/types/zod.d.ts"
    },
    "./valibot": {
      "bun": "./src/valibot.ts",
      "import": "./lib/valibot.js",
      "types": "./lib/types/valibot.d.ts"
    },
    "./arktype": {
      "bun": "./src/arktype.ts",
      "import": "./lib/arktype.js",
      "types": "./lib/types/arktype.d.ts"
    },
    "./native-plugin": {
      "bun": "./src/native-plugin.ts",
      "import": "./lib/native-plugin.js",
      "types": "./lib/types/native-plugin.d.ts"
    }
  },
  "files": [
    "lib",
    "!lib/analysis",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vl_rolldown_build",
    "dev": "vl_rolldown_build-watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "bench:validation": "NODE_ENV=production bun bench/validation-bench.ts"
  },
  "peerDependencies": {
    "@pyreon/native-compiler": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@pyreon/native-compiler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@pyreon/core": "workspace:^",
    "@pyreon/form": "workspace:^",
    "@pyreon/manifest": "workspace:*",
    "@pyreon/native-compiler": "workspace:*",
    "@pyreon/reactivity": "workspace:^",
    "@pyreon/runtime-dom": "workspace:^",
    "@pyreon/store": "workspace:^",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vitest-config": "workspace:*",
    "arktype": "^2.2.5",
    "valibot": "^1.5.0",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "pyreon": {
    "native": {
      "plugin": "./lib/native-plugin.js",
      "modules": [
        "@pyreon/validation"
      ]
    }
  }
}
