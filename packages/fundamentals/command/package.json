{
  "name": "@pyreon/command",
  "version": "0.54.0",
  "description": "A command palette for Pyreon: a fuzzy matcher, a registry of commands with shortcuts, recents and async sources",
  "license": "MIT",
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/fundamentals/command#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/fundamentals/command"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./core": {
      "bun": "./src/core.ts",
      "import": "./lib/core.js",
      "types": "./lib/types/core.d.ts"
    },
    "./components": {
      "bun": "./src/components.tsx",
      "import": "./lib/components.js",
      "types": "./lib/types/components.d.ts"
    },
    "./style.css": "./style.css",
    "./router": {
      "bun": "./src/router.ts",
      "import": "./lib/router.js",
      "types": "./lib/types/router.d.ts"
    },
    "./internal": {
      "bun": "./src/internal.ts",
      "import": "./lib/internal.js",
      "types": "./lib/types/internal.d.ts"
    }
  },
  "files": [
    "lib",
    "!lib/analysis",
    "src",
    "style.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vl_rolldown_build",
    "dev": "vl_rolldown_build-watch",
    "test": "vitest run --maxWorkers=2",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test:browser": "vitest run --config ./vitest.browser.config.ts"
  },
  "dependencies": {
    "@pyreon/hotkeys": "workspace:^"
  },
  "peerDependencies": {
    "@pyreon/reactivity": "workspace:^",
    "@pyreon/core": "workspace:^"
  },
  "devDependencies": {
    "@pyreon/core": "workspace:*",
    "@pyreon/i18n": "workspace:*",
    "@pyreon/manifest": "workspace:*",
    "@pyreon/reactivity": "workspace:*",
    "@pyreon/router": "workspace:*",
    "@pyreon/runtime-dom": "workspace:*",
    "@pyreon/runtime-server": "workspace:*",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vitest-config": "workspace:*",
    "@vitest/browser-playwright": "^5.1.0",
    "axe-core": "^4.14.1"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "pyreon": {
    "stability": "experimental"
  }
}
