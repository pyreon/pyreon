{
  "name": "@pyreon/hooks",
  "version": "0.51.0",
  "description": "Signal-based reactive utilities for Pyreon",
  "license": "MIT",
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/fundamentals/hooks#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/fundamentals/hooks"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    }
  },
  "files": [
    "lib",
    "!lib/analysis",
    "README.md",
    "LICENSE",
    "src",
    "native/swift",
    "native/kotlin"
  ],
  "scripts": {
    "prepublish": "bun run build",
    "build": "bun run vl_rolldown_build",
    "build:watch": "bun run vl_rolldown_build-watch",
    "bench:hooks": "NODE_ENV=production bun bench/hooks-bench.ts",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:browser": "vitest run --config ./vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@pyreon/core": "workspace:^",
    "@pyreon/reactivity": "workspace:^"
  },
  "devDependencies": {
    "@pyreon/manifest": "workspace:*",
    "@pyreon/runtime-dom": "workspace:^",
    "@pyreon/test-utils": "workspace:^",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/typescript": "workspace:^",
    "@pyreon/vitest-config": "workspace:*",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitus-labs/tools-rolldown": "^2.6.3"
  },
  "engines": {
    "node": ">= 22"
  },
  "publishConfig": {
    "access": "public"
  },
  "pyreon": {
    "native": {
      "swift": "native/swift",
      "kotlin": "native/kotlin",
      "kotlinServices": {
        "PyreonAppStateAndroid": [
          "PyreonAppState.kt",
          "PyreonAppStateAndroid.kt"
        ],
        "PyreonAuth": [
          "PyreonAuth.kt",
          "@base/PyreonHttp.kt"
        ],
        "PyreonBluetooth": [
          "PyreonBluetooth.kt"
        ],
        "PyreonBiometrics": [
          "PyreonBiometrics.kt"
        ],
        "PyreonClipboard": [
          "PyreonClipboard.kt"
        ],
        "PyreonCrashReporterAndroid": [
          "PyreonCrashReporter.kt",
          "PyreonCrashReporterAndroid.kt",
          "@base/PyreonStorageBackends.kt",
          "@base/PyreonJson.kt"
        ],
        "PyreonDatabaseAndroid": [
          "PyreonDatabase.kt",
          "PyreonDatabaseAndroid.kt",
          "@base/PyreonJson.kt"
        ],
        "PyreonFetch": [
          "PyreonFetch.kt",
          "@base/PyreonJson.kt"
        ],
        "PyreonFilePicker": [
          "PyreonFilePicker.kt"
        ],
        "PyreonGeolocationAndroid": [
          "PyreonGeolocation.kt",
          "PyreonGeolocationAndroid.kt",
          "@base/PyreonStorageBackends.kt"
        ],
        "PyreonHaptics": [
          "PyreonHaptics.kt"
        ],
        "PyreonImagePicker": [
          "PyreonImagePicker.kt"
        ],
        "PyreonLinking": [
          "PyreonLinking.kt"
        ],
        "PyreonMapState": [
          "PyreonMapState.kt"
        ],
        "PyreonNetworkStatusAndroid": [
          "PyreonNetworkStatus.kt",
          "PyreonNetworkStatusAndroid.kt"
        ],
        "PyreonNotifications": [
          "PyreonNotifications.kt"
        ],
        "PyreonPayments": [
          "PyreonPayments.kt"
        ],
        "PyreonPushNotificationsAndroid": [
          "PyreonPushNotifications.kt",
          "PyreonPushNotificationsAndroid.kt"
        ],
        "PyreonShare": [
          "PyreonShare.kt"
        ],
        "PyreonAudioPlayer": [
          "PyreonAudioPlayer.kt"
        ],
        "PyreonAudioPlayerAndroid": [
          "PyreonAudioPlayer.kt",
          "PyreonAudioPlayerAndroid.kt"
        ],
        "PyreonAudioEngineMedia3": [
          "PyreonAudioPlayer.kt",
          "PyreonAudioEngineMedia3.kt"
        ],
        "PyreonAudioRecorder": [
          "PyreonAudioRecorder.kt"
        ],
        "PyreonCamera": [
          "PyreonCamera.kt"
        ],
        "PyreonSpeech": [
          "PyreonSpeech.kt"
        ],
        "PyreonDeviceMotion": [
          "PyreonDeviceMotion.kt"
        ],
        "PyreonWakeLock": [
          "PyreonWakeLock.kt"
        ],
        "PyreonDeviceInfo": [
          "PyreonDeviceInfo.kt"
        ],
        "PyreonSafeArea": [
          "PyreonSafeArea.kt"
        ],
        "PyreonVideoPlayerAndroid": [
          "PyreonVideoPlayerAndroid.kt"
        ],
        "PyreonWebSocketOkHttp": [
          "PyreonWebSocket.kt",
          "PyreonWebSocketOkHttp.kt"
        ],
        "PyreonRateLimit": [
          "PyreonRateLimit.kt"
        ]
      },
      "kotlinSdkOnly": [
        "PyreonWebView.kt"
      ]
    }
  },
  "dependencies": {
    "@pyreon/storage": "workspace:*"
  }
}
