{
  "name": "@pyreon/storage",
  "version": "0.51.0",
  "description": "Reactive client-side storage for Pyreon \u2014 localStorage, sessionStorage, cookies, IndexedDB",
  "license": "MIT",
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/fundamentals/storage#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/fundamentals/storage"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    }
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE",
    "native/swift",
    "native/kotlin"
  ],
  "scripts": {
    "build": "vl_rolldown_build",
    "dev": "vl_rolldown_build-watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "bench:storage": "NODE_ENV=production bun bench/storage-bench.ts"
  },
  "peerDependencies": {
    "@pyreon/reactivity": "workspace:^"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.6",
    "@pyreon/manifest": "workspace:*",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vitest-config": "workspace:*",
    "@vitus-labs/tools-lint": "^2.7.1",
    "bun-types": "^1.3.14",
    "fake-indexeddb": "^6.2.5",
    "jotai": "^2.20.3",
    "zustand": "^5.0.15"
  },
  "publishConfig": {
    "access": "public"
  },
  "pyreon": {
    "native": {
      "swift": "native/swift",
      "kotlin": "native/kotlin",
      "kotlinServices": {
        "PyreonSecureStorageAndroid": [
          "@base/PyreonStorageBackends.kt",
          "PyreonStorage.kt",
          "PyreonStorageAndroid.kt",
          "PyreonSecureStorage.kt",
          "PyreonSecureStorageAndroid.kt"
        ]
      }
    }
  }
}
