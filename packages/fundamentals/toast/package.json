{
  "name": "@pyreon/toast",
  "version": "0.55.0",
  "description": "Imperative toast notifications for Pyreon — no provider needed",
  "license": "MIT",
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/fundamentals/toast#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/fundamentals/toast"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./native-plugin": {
      "bun": "./src/native-plugin.ts",
      "import": "./lib/native-plugin.js",
      "types": "./lib/types/native-plugin.d.ts"
    },
    "./internal": {
      "bun": "./src/internal.ts",
      "import": "./lib/internal.js",
      "types": "./lib/types/internal.d.ts"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "lib",
    "!lib/analysis",
    "src",
    "styles.css",
    "README.md",
    "LICENSE",
    "native/swift",
    "native/kotlin"
  ],
  "scripts": {
    "build": "vl_rolldown_build",
    "dev": "vl_rolldown_build-watch",
    "test": "vitest run",
    "test:browser": "vitest run --config ./vitest.browser.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "bench": "NODE_ENV=production bun bench/toast-bench.ts",
    "bench:commit": "NODE_ENV=production bun bench/toast-commit-bench.ts"
  },
  "peerDependencies": {
    "@pyreon/core": "workspace:^",
    "@pyreon/reactivity": "workspace:^",
    "@pyreon/runtime-dom": "workspace:^",
    "@pyreon/native-compiler": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@pyreon/native-compiler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@pyreon/manifest": "workspace:*",
    "@pyreon/native-compiler": "workspace:*",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vitest-config": "workspace:*",
    "@vitest/browser-playwright": "^5.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "sonner": "^2.0.8"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "pyreon": {
    "stability": "stable",
    "experimentalSubpaths": ["./native-plugin"],
    "native": {
      "swift": "native/swift",
      "kotlin": "native/kotlin",
      "kotlinServices": {
        "PyreonToast": [
          "PyreonToast.kt"
        ]
      },
      "kotlinSdkOnly": [
        "PyreonToaster.kt"
      ],
      "plugin": "./lib/native-plugin.js",
      "modules": [
        "@pyreon/toast"
      ]
    }
  }
}
