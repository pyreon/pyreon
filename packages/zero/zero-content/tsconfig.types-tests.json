{
  // Narrow typecheck for the `*.types.test.ts` compile-time regressions.
  //
  // The main `tsconfig.json` EXCLUDES `src/tests`, so an `expectTypeOf`
  // assertion there would never be checked. This config compiles ONLY the
  // `.types.test.ts` files (plus the sources they import), and the package
  // `typecheck` script runs it after the main `tsc`, so the existing CI
  // `Typecheck` job enforces it with no new job.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false
  },
  "include": ["src/tests/**/*.types.test.ts"],
  "exclude": []
}
