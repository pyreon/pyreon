{
  "$schema": "https://json.schemastore.org/tsconfig",
  // DOGFOODING: the repo's canon layers on the PUBLISHED @pyreon/typescript
  // presets (the ones users install), so every repo typecheck exercises the
  // shipped product. Everything below is the REPO-SPECIFIC delta — options
  // the published preset deliberately doesn't impose on consumers.
  "extends": "@pyreon/typescript",
  "compilerOptions": {
    // Repo-internal resolution + hygiene (not for consumers):
    "customConditions": ["bun"],
    "isolatedModules": true,
    // The repo authors JSX for the REAL Pyreon compiler; `preserve` is the
    // base semantic (packages with JSX tests opt into react-jsx via
    // lib-jsx.json). The published preset defaults consumers to react-jsx.
    "jsx": "preserve",
    // Permits `.ts` extensions in relative imports. Required for
    // `@pyreon/vitest-config`'s source files, which use explicit `.ts`
    // extensions so its `vitest.config.ts` callers can resolve them via
    // Vite's config loader (Node ESM strict mode requires extensions for
    // relative imports). All other packages can keep using extensionless
    // imports — this flag only PERMITS the `.ts` form, it never requires
    // it. Pairs with `moduleResolution: Bundler`.
    "allowImportingTsExtensions": true,
    // Parity block — options the pre-consolidation chain (@vitus-labs/
    // tools-typescript/lib) provided that the published preset doesn't;
    // kept verbatim so the migration changes ZERO effective options
    // (verified by tsc --showConfig diffs across every preset shape):
    "types": ["node"],
    "esModuleInterop": true,
    "allowJs": true,
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "noEmit": true,
    // Every package resolves its `@pyreon/*` dependencies to their SOURCE (the
    // `bun` condition), so a typecheck re-parses its whole dependency subtree —
    // `@pyreon/core`'s src is parsed again by each of the ~70 packages that
    // depend on it. Measured on the full workspace: 143 typechecks, 701s of CPU.
    //
    // `incremental` lets each package reuse the type information it already
    // computed, keyed on file versions. Measured on `@pyreon/core`: 0.90s ->
    // 0.41s wall, 1.90s -> 0.92s CPU on a repeat run — which is the case the
    // pre-push hook hits on every push after the first.
    //
    // Correctness is NOT traded away for it, and that was verified rather than
    // assumed: an error introduced in the package's own src is still reported,
    // and so is one introduced in a DEPENDENCY's src across the workspace alias
    // (breaking `signal()`'s arity in @pyreon/reactivity surfaces TS2554 in
    // @pyreon/core's files). TypeScript versions every file in the program, not
    // just the package's own.
    //
    // The cache lives under the package's `node_modules`, so it is ignored by
    // git for free and cannot be mistaken for build output.
    "incremental": true,
    "tsBuildInfoFile": "${configDir}/node_modules/.cache/tsbuildinfo"
  },
  "exclude": ["${configDir}/node_modules", "${configDir}/**/lib/**", "${configDir}/**/dist/**"]
}
