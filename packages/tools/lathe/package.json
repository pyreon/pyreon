{
  "name": "@pyreon/lathe",
  "version": "0.51.0",
  "description": "Spec-to-Pyreon code generator \u2014 OpenAPI in, typed schemas / endpoints / queries out, with a multiplatform mode that proves its own output lowers to Swift and Kotlin.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/tools/lathe#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/tools/lathe"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "bin": {
    "lathe": "./bin/lathe.js"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./core": {
      "bun": "./src/core.ts",
      "import": "./lib/core.js",
      "types": "./lib/types/core.d.ts"
    },
    "./cli": {
      "bun": "./src/cli.ts",
      "import": "./lib/cli.js",
      "types": "./lib/types/cli.d.ts"
    },
    "./vite": {
      "bun": "./src/vite.ts",
      "import": "./lib/vite.js",
      "types": "./lib/types/vite.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vl_rolldown_build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "bench": "bun bench/scaling.ts"
  },
  "devDependencies": {
    "@pyreon/manifest": "workspace:*",
    "@pyreon/native-compiler": "workspace:*",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/validate": "workspace:*",
    "@pyreon/vitest-config": "workspace:*"
  },
  "dependencies": {
    "@pyreon/config": "workspace:*",
    "@pyreon/reactivity": "workspace:*"
  },
  "peerDependencies": {
    "@pyreon/native-compiler": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@pyreon/native-compiler": {
      "optional": true
    }
  }
}
