{
  "name": "@pyreon/atlas",
  "version": "0.51.0",
  "description": "AI-native component workbench for the Pyreon ecosystem \u2014 derives, verifies, and serves a machine-readable component catalog.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/tools/atlas#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/tools/atlas"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "bin": {
    "atlas": "./bin/atlas.js"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./core": {
      "bun": "./src/core.ts",
      "import": "./lib/core.js",
      "types": "./lib/types/core.d.ts"
    },
    "./plugins": {
      "bun": "./src/plugins.ts",
      "import": "./lib/plugins.js",
      "types": "./lib/types/plugins.d.ts"
    },
    "./auto": {
      "bun": "./src/auto.ts",
      "import": "./lib/auto.js",
      "types": "./lib/types/auto.d.ts"
    },
    "./discover": {
      "bun": "./src/discover.ts",
      "import": "./lib/discover.js",
      "types": "./lib/types/discover.d.ts"
    },
    "./cli": {
      "bun": "./src/cli.ts",
      "import": "./lib/cli.js",
      "types": "./lib/types/cli.d.ts"
    },
    "./ui": {
      "bun": "./src/ui.ts",
      "import": "./lib/ui.js",
      "types": "./lib/types/ui.d.ts"
    },
    "./package.json": "./package.json",
    "./dev": {
      "bun": "./src/dev.ts",
      "import": "./lib/dev.js",
      "types": "./lib/types/dev.d.ts"
    }
  },
  "files": [
    "bin",
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vl_rolldown_build",
    "dev": "vl_rolldown_build-watch",
    "demo": "bun scripts/demo.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@pyreon/code": "workspace:*",
    "@pyreon/config": "workspace:*",
    "@pyreon/core": "workspace:*",
    "@pyreon/elements": "workspace:*",
    "@pyreon/feature": "workspace:*",
    "@pyreon/hooks": "workspace:*",
    "@pyreon/permissions": "workspace:*",
    "@pyreon/reactivity": "workspace:*",
    "@pyreon/rocketstyle": "workspace:*",
    "@pyreon/runtime-dom": "workspace:*",
    "@pyreon/styler": "workspace:*",
    "@pyreon/ui-core": "workspace:*",
    "@pyreon/unistyle": "workspace:*",
    "axe-core": "^4.11.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "typescript": ">=5.0.0 <7.0.0"
  },
  "devDependencies": {
    "@pyreon/compiler": "workspace:*",
    "@pyreon/manifest": "workspace:*",
    "@pyreon/query": "workspace:*",
    "@pyreon/runtime-server": "workspace:*",
    "@pyreon/store": "workspace:*",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vite-plugin": "workspace:*",
    "@pyreon/vitest-config": "workspace:*",
    "happy-dom": "^20.11.1",
    "playwright-core": ">=1.40",
    "vite": "^8.2.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@pyreon/compiler": "workspace:*",
    "@pyreon/store": "workspace:*",
    "@pyreon/vite-plugin": "workspace:*",
    "happy-dom": ">=15",
    "playwright-core": ">=1.40",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "@pyreon/compiler": {
      "optional": true
    },
    "@pyreon/store": {
      "optional": true
    },
    "@pyreon/vite-plugin": {
      "optional": true
    },
    "happy-dom": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
