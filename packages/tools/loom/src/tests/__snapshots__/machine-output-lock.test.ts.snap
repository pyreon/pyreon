// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`loom scan --json is locked > --json (writing): the write notice goes to stderr > stderr 1`] = `
"  → <root>/loom-report.json
loom: 5 error(s)
"
`;

exports[`loom scan --json is locked > --json --no-write: the report on stdout, the red count on stderr > stderr 1`] = `
"loom: 5 error(s)
"
`;

