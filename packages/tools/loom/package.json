{
  "name": "@pyreon/loom",
  "version": "0.52.0",
  "description": "Monorepo dependency observatory — workspace graph, version-sync drift, cycles, phantom deps, and blast radius, as data.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/tools/loom#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/tools/loom"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "bin": {
    "loom": "./bin/loom.js"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./core": {
      "bun": "./src/core.ts",
      "import": "./lib/core.js",
      "types": "./lib/types/core.d.ts"
    },
    "./cli": {
      "bun": "./src/cli.ts",
      "import": "./lib/cli.js",
      "types": "./lib/types/cli.d.ts"
    },
    "./ui": {
      "bun": "./src/ui.ts",
      "import": "./lib/ui.js",
      "types": "./lib/types/ui.d.ts"
    },
    "./dev": {
      "bun": "./src/dev.ts",
      "import": "./lib/dev.js",
      "types": "./lib/types/dev.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vl_rolldown_build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint ."
  },
  "devDependencies": {
    "@pyreon/head": "workspace:*",
    "@pyreon/manifest": "workspace:*",
    "@pyreon/router": "workspace:*",
    "@pyreon/runtime-server": "workspace:*",
    "@pyreon/server": "workspace:*",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vite-plugin": "workspace:*",
    "@pyreon/vitest-config": "workspace:*",
    "@pyreon/zero": "workspace:*",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@pyreon/config": "workspace:*",
    "@pyreon/core": "workspace:*",
    "@pyreon/elements": "workspace:*",
    "@pyreon/hooks": "workspace:*",
    "@pyreon/reactivity": "workspace:*",
    "@pyreon/rocketstyle": "workspace:*",
    "@pyreon/runtime-dom": "workspace:*",
    "@pyreon/styler": "workspace:*",
    "@pyreon/ui-core": "workspace:*",
    "@pyreon/unistyle": "workspace:*"
  },
  "peerDependencies": {
    "@pyreon/head": "workspace:*",
    "@pyreon/router": "workspace:*",
    "@pyreon/runtime-server": "workspace:*",
    "@pyreon/server": "workspace:*",
    "@pyreon/vite-plugin": "workspace:*",
    "@pyreon/zero": "workspace:*",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "@pyreon/head": {
      "optional": true
    },
    "@pyreon/router": {
      "optional": true
    },
    "@pyreon/runtime-server": {
      "optional": true
    },
    "@pyreon/server": {
      "optional": true
    },
    "@pyreon/vite-plugin": {
      "optional": true
    },
    "@pyreon/zero": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
