{
  "name": "@pyreon/router",
  "version": "0.53.0",
  "description": "Official router for Pyreon",
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/core/router#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/core/router"
  },
  "files": [
    "lib",
    "!lib/analysis",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./native-plugin": {
      "bun": "./src/native-plugin.ts",
      "import": "./lib/native-plugin.js",
      "types": "./lib/types/native-plugin.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vl_rolldown_build",
    "dev": "vl_rolldown_build-watch",
    "test": "vitest run",
    "test:browser": "vitest run --config ./vitest.browser.config.ts",
    "test:browser:engines": "vitest run --config ./vitest.browser.engines.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@pyreon/sized-map": "workspace:*"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.3",
    "@pyreon/manifest": "workspace:*",
    "@pyreon/native-compiler": "workspace:*",
    "@pyreon/test-utils": "workspace:^",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vitest-config": "workspace:*",
    "@vitest/browser-playwright": "^5.0.5",
    "happy-dom": "^21.0.3"
  },
  "peerDependencies": {
    "@pyreon/core": "workspace:^",
    "@pyreon/native-compiler": "workspace:^",
    "@pyreon/reactivity": "workspace:^",
    "@pyreon/runtime-dom": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@pyreon/native-compiler": {
      "optional": true
    }
  },
  "pyreon": {
    "native": {
      "plugin": "./lib/native-plugin.js",
      "modules": [
        "@pyreon/router"
      ]
    }
  }
}
