{
  "name": "@pyreon/head",
  "version": "0.54.0",
  "description": "Head tag management for Pyreon \u2014 works in SSR and CSR",
  "license": "MIT",
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/core/head#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/core/head"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./context": {
      "bun": "./src/context.ts",
      "import": "./lib/context.js",
      "types": "./lib/types/context.d.ts"
    },
    "./provider": {
      "bun": "./src/provider.ts",
      "import": "./lib/provider.js",
      "types": "./lib/types/provider.d.ts"
    },
    "./use-head": {
      "bun": "./src/use-head.ts",
      "import": "./lib/use-head.js",
      "types": "./lib/types/use-head.d.ts"
    },
    "./ssr": {
      "bun": "./src/ssr.ts",
      "import": "./lib/ssr.js",
      "types": "./lib/types/ssr.d.ts"
    },
    "./native-plugin": {
      "bun": "./src/native-plugin.ts",
      "import": "./lib/native-plugin.js",
      "types": "./lib/types/native-plugin.d.ts"
    }
  },
  "files": [
    "lib",
    "!lib/analysis",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vl_rolldown_build",
    "dev": "vl_rolldown_build-watch",
    "test": "vitest run",
    "test:browser": "vitest run --config ./vitest.browser.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@pyreon/core": "workspace:^",
    "@pyreon/reactivity": "workspace:^",
    "@pyreon/native-compiler": "workspace:^"
  },
  "dependencies": {
    "@pyreon/runtime-server": "workspace:^"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@pyreon/manifest": "workspace:*",
    "@pyreon/native-compiler": "workspace:*",
    "@pyreon/runtime-dom": "workspace:^",
    "@pyreon/test-utils": "workspace:^",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vitest-config": "workspace:*",
    "@vitest/browser-playwright": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@pyreon/native-compiler": {
      "optional": true
    }
  },
  "pyreon": {
    "native": {
      "plugin": "./lib/native-plugin.js",
      "modules": [
        "@pyreon/head"
      ]
    }
  }
}
