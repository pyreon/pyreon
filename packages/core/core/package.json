{
  "name": "@pyreon/core",
  "version": "0.54.0",
  "description": "Core component model and lifecycle for Pyreon",
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/core/core#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/core/core"
  },
  "files": [
    "lib",
    "!lib/analysis",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./jsx-runtime": {
      "bun": "./src/jsx-runtime.ts",
      "import": "./lib/jsx-runtime.js",
      "types": "./lib/types/jsx-runtime.d.ts"
    },
    "./jsx-dev-runtime": {
      "bun": "./src/jsx-dev-runtime.ts",
      "import": "./lib/jsx-dev-runtime.js",
      "types": "./lib/types/jsx-dev-runtime.d.ts"
    },
    "./plain": {
      "bun": "./src/plain.ts",
      "import": "./lib/plain.js",
      "types": "./lib/types/plain.d.ts"
    },
    "./native-plugin": {
      "bun": "./src/native-plugin.ts",
      "import": "./lib/native-plugin.js",
      "types": "./lib/types/native-plugin.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vl_rolldown_build",
    "dev": "vl_rolldown_build-watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@pyreon/manifest": "workspace:*",
    "@pyreon/native-compiler": "workspace:*",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/vitest-config": "workspace:*"
  },
  "peerDependencies": {
    "@pyreon/native-compiler": "workspace:^",
    "@pyreon/reactivity": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@pyreon/native-compiler": {
      "optional": true
    }
  },
  "pyreon": {
    "native": {
      "plugin": "./lib/native-plugin.js",
      "modules": [
        "@pyreon/core"
      ]
    }
  }
}
