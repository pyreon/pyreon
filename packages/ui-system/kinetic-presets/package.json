{
  "name": "@pyreon/kinetic-presets",
  "version": "0.52.0",
  "description": "120+ animation presets for Pyreon transitions",
  "homepage": "https://github.com/pyreon/pyreon/tree/main/packages/ui-system/kinetic-presets#readme",
  "bugs": {
    "url": "https://github.com/pyreon/pyreon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyreon/pyreon.git",
    "directory": "packages/ui-system/kinetic-presets"
  },
  "files": [
    "lib",
    "!lib/analysis",
    "README.md",
    "LICENSE",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./native-plugin": {
      "bun": "./src/native-plugin.ts",
      "import": "./lib/native-plugin.js",
      "types": "./lib/native-plugin.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublish": "bun run build",
    "build": "bun run vl_rolldown_build",
    "build:watch": "bun run vl_rolldown_build-watch",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@pyreon/manifest": "workspace:*",
    "@pyreon/native-compiler": "workspace:*",
    "@pyreon/tsconfig": "workspace:*",
    "@pyreon/typescript": "workspace:^",
    "@pyreon/vitest-config": "workspace:*",
    "@vitus-labs/tools-rolldown": "^2.6.3"
  },
  "peerDependencies": {
    "@pyreon/native-compiler": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@pyreon/native-compiler": {
      "optional": true
    }
  },
  "engines": {
    "node": ">= 22"
  },
  "pyreon": {
    "native": {
      "plugin": "./lib/native-plugin.js",
      "modules": [
        "@pyreon/kinetic-presets"
      ]
    }
  }
}
