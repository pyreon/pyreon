{
  // Typechecks the repo's own scripts (gates, benches, generators). They are
  // not a package, so `bun run typecheck` (per-package) never saw them: a
  // script importing a workspace export that was renamed or removed failed
  // only when someone ran it (#4751 review: `bench:loom` died on the removed
  // `detectPeerMismatch`). `scripts/check-scripts-typecheck.ts` (in
  // validate-fast) typechecks with it and fails on any diagnostic.
  "extends": "../tsconfig.json",
  "compilerOptions": { "noEmit": true, "types": ["node", "bun"] },
  "include": ["./**/*.ts"]
}
